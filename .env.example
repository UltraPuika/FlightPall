# Copy to .env.local for local development. NEVER put API tokens here - the frontend is public.
# URL of your own deployed proxy worker (see worker/README.md). Leave empty to use demo / links-only mode.
VITE_TRAVELPAYOUTS_PROXY_URL=
# Base path for GitHub Pages builds (default /FlightPall/). Use / for a custom domain or local preview.
# VITE_BASE_PATH=/FlightPall/
